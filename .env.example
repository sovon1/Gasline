# ==============================================================================
# GasLine — Environment Configuration (Optional)
# ==============================================================================
# GasLine runs 100% OFFLINE on CPU with local scikit-learn models and its
# deterministic SCADA reasoning engine. Zero API keys are required to run the
# full application or pass all 48 automated tests.
#
# Copy this file to `.env` only if you want live online LLM responses inside the
# optional AI Copilot modal (or pass any key directly in the Copilot UI modal).
# ==============================================================================

# Optional: Google Gemini API key (used by POST /api/copilot/chat & /models)
GEMINI_API_KEY=

# Optional fallback alias checked if GEMINI_API_KEY is unset
GOOGLE_API_KEY=

# Optional: Groq API key (for ultra-fast Llama inference in AI Copilot)
GROQ_API_KEY=

# Optional: OpenAI API key (for GPT-4o inference in AI Copilot)
OPENAI_API_KEY=
